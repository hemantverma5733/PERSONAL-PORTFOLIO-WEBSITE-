# Email Configuration for Nodemailer
# Replace these with your actual email credentials.
# Note: If using Gmail, you must use an "App Password" rather than your normal password.
# To generate an App Password in Google: Go to Manage your Google Account -> Security -> 2-Step Verification -> App Passwords.

EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password

# Port configuration
PORT=3000
